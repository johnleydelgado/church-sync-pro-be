# Build stage -------------------------------------------------------------
# node:14-slim was Debian buster, whose apt repositories are now archived, so
# that image stopped building at all. 18 matches .nvmrc and is what jest needs.
FROM node:18-slim AS build

WORKDIR /usr/src/app

# Copy the lockfile too. The previous `COPY package*.json` never matched
# yarn.lock, so every build re-resolved dependencies from semver ranges and
# no build was reproducible.
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile

COPY tsconfig.json index.ts ./
COPY src ./src
RUN yarn tsc

# tsc does not emit .json, and src/db/index.ts requires ./config/config.json
# at runtime, so place it alongside the compiled output.
RUN mkdir -p dist/src/db/config \
 && cp src/db/config/config.json dist/src/db/config/config.json

# Runtime stage -----------------------------------------------------------
FROM node:18-slim AS runtime

WORKDIR /usr/src/app

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --production && yarn cache clean

COPY --from=build /usr/src/app/dist ./dist

EXPOSE 8080
CMD [ "node", "dist/index.js" ]
