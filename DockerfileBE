# Build stage -------------------------------------------------------------
# node:14-slim was Debian buster, whose apt repositories are now archived, so
# that image stopped building at all. 18 matches .nvmrc and is what jest needs.
FROM node:18-slim AS build

WORKDIR /usr/src/app

# Copy the lockfile too. The previous `COPY package*.json` never matched
# yarn.lock, so every build re-resolved dependencies from semver ranges and
# no build was reproducible.
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --network-timeout 600000

COPY tsconfig.json index.ts ./
COPY src ./src
RUN yarn tsc

# tsc does not emit .json, and src/db/index.ts requires ./config/config.json
# at runtime, so place it alongside the compiled output.
RUN mkdir -p dist/src/db/config \
 && cp src/db/config/config.json dist/src/db/config/config.json

# Prune dev dependencies HERE, where yarn's cache is already warm, instead of
# doing a second full download in the runtime stage. That second fetch timed out
# against the registry and failed the staging deploy; this stage needs no network.
RUN yarn install --frozen-lockfile --production --ignore-scripts --network-timeout 600000 \
 && yarn cache clean

# Runtime stage -----------------------------------------------------------
FROM node:18-slim AS runtime

WORKDIR /usr/src/app

COPY package.json yarn.lock ./
COPY --from=build /usr/src/app/node_modules ./node_modules
COPY --from=build /usr/src/app/dist ./dist

EXPOSE 8080
CMD [ "node", "dist/index.js" ]
