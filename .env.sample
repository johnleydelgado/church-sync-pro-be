# Church Sync Pro — Backend API environment variables
# Copy this file to `.env` (and `.env.staging` / `.env.production` for deploys)
# and fill in the values. Do NOT commit real secrets.

# Runtime
NODE_ENV=development
SECRET=your_app_secret

# API / SuperTokens
API_URL=http://localhost:8080
API_KEYS=your_supertokens_core_api_key

# Planning Center OAuth
PC_APP_ID=your_planning_center_app_id
PC_SECRET=your_planning_center_secret
PC_CLIENT_ID=your_planning_center_client_id
PC_SECRET_APP=your_planning_center_app_secret
PC_REDIRECT=http://localhost:3000/auth/callback/planning-center

# QuickBooks Online OAuth
QBO_KEY=your_quickbooks_client_id
QBO_SECRET=your_quickbooks_client_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUB_KEY=pk_test_your_stripe_publishable_key
STRIPE_CLIENT_ID=ca_your_stripe_connect_client_id

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# SendGrid (transactional email)
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# Frontend link bases (used in emails)
INVITATION_URL=http://localhost:3000/invite-bookkeeper
RESET_PASSWORD_URL=http://localhost:3000/reset-password
SETTING_FUND_URL=http://localhost:3000/settings

# Automation endpoints shared secret
# Required to call the all-tenant automation routes (/automationScheduler,
# /latestFundAutomation, /latestRegistrationAutomation, /checkLatestFund,
# /checkLatestRegistration) via the `x-automation-key` request header.
AUTOMATION_API_KEY=your_long_random_shared_secret

# Which QuickBooks to write to, independent of NODE_ENV.
# 'true'  -> sandbox (safe for any test stack, whatever it is named)
# 'false' -> a customer's REAL QuickBooks company file
# Unset falls back to the old behaviour: real QBO only when NODE_ENV=production.
QBO_USE_SANDBOX=true
